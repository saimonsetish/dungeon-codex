<%- include('partials/header') %>

<p class="back"><a href="/">&larr; New search</a></p>
<h1><%= type === 'spell' ? 'Spells' : 'Monsters' %> found: <%= total %></h1>
<p class="muted">
  Search:
  <% if (query.name) { %>name "<%= query.name %>"<% } %>
  <% if (query.level !== '' && type === 'spell') { %> level <%= query.level %><% } %>
  <% if (query.cr !== '' && type === 'monster') { %> challenge rating <%= query.cr %><% } %>
</p>

<% if (failed > 0) { %>
  <div class="notice" role="status"><%= failed %> result<%= failed === 1 ? '' : 's' %> could not be loaded and <%= failed === 1 ? 'is' : 'are' %> missing below.</div>
<% } %>
<% if (total > shown + failed) { %>
  <div class="notice" role="status">Showing the first <%= shown %> of <%= total %>. Add a name or a narrower filter to see others.</div>
<% } %>

<% if (shown === 0) { %>
  <div class="empty">
    <h2>No <%= type %>s match that search</h2>
    <p>Try a shorter name, remove one filter, or <a href="/">start a new search</a>.</p>
  </div>

<% } else if (type === 'spell') { %>
  <% groups.forEach(function (group) { %>
    <section class="group">
      <h2 class="group-title school-<%= group.slug %>"><%= group.school %> <span class="count">(<%= group.spells.length %>)</span></h2>
      <div class="grid">
        <% group.spells.forEach(function (spell) { %><%- include('partials/spellCard', { spell: spell }) %><% }); %>
      </div>
    </section>
  <% }); %>

<% } else { %>
  <% if (stats) { %>
    <dl class="stats">
      <div><dt>Average HP</dt><dd><%= stats.avgHp %></dd></div>
      <div><dt>Average AC</dt><dd><%= stats.avgAc %></dd></div>
      <div><dt>Toughest shown</dt><dd><%= stats.strongest.name %> (CR <%= stats.strongest.crLabel %>)</dd></div>
    </dl>
  <% } %>
  <div class="grid">
    <% monsters.forEach(function (monster) { %><%- include('partials/monsterCard', { monster: monster }) %><% }); %>
  </div>
<% } %>

<%- include('partials/footer') %>
